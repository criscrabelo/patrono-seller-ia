generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Workspace — fundação de isolamento de dados.
//
// Hoje cada usuária tem exatamente UM workspace próprio (relação 1:1: ao
// registrar, cria-se um workspace com ela como dona). Não existe ainda
// conceito de equipe/organização compartilhando o mesmo workspace — isso é
// modelado como `members: User[]` para não exigir outra migração quando
// isso for necessário, mas por enquanto só a dona é membro do próprio
// workspace.
//
// Todo registro operacional (produto, link, conteúdo, integração, programa
// de afiliados, venda, comissão, log de auditoria) pertence a um workspace.
// O isolamento é reforçado nas rotas de API filtrando sempre por
// `workspaceId` (nunca confiando em filtro de tela) — ver
// DOCUMENTACAO-PATRONO-SELLER.md.
model Workspace {
  id      String @id @default(cuid())
  name    String
  // Proveniência apenas — "quem fundou este workspace". De propósito SEM
  // chave estrangeira: criar workspace e usuária é uma referência circular
  // (a usuária dona do workspace dela mesma), então isso é gravado como
  // texto simples em vez de relação, e resolvido em lib/workspace.ts.
  // A fronteira de isolamento de verdade é `User.workspaceId` abaixo, que É
  // uma chave estrangeira obrigatória.
  ownerId String @unique

  members User[] @relation("WorkspaceMembers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Autopilot (Rodada 5) ──────────────────────────────────────────
  // Kill switch: "PAUSAR AUTOMAÇÃO" por workspace. Nenhum job novo publica
  // enquanto true; jobs em andamento devem respeitar isso antes da etapa
  // externa (ver lib/autopilot.ts).
  automationPaused Boolean @default(true)
  // MANUAL: nada automático. DRY_RUN: roda o ciclo até READY_TO_PUBLISH mas
  // nunca chama publicação real. AUTOMATIC: pode publicar de verdade quando
  // todas as pré-condições da Rodada 5 forem atendidas.
  automationMode String @default("MANUAL")

  produtos          Produto[]
  linksDinamicos    LinkDinamico[]
  integracoes       Integracao[]
  conteudos         Conteudo[]
  affiliatePrograms AffiliateProgram[]
  sales             Sale[]
  commissions       Commission[]
  auditLogs         AuditLog[]
  eventosLink       EventoLink[]

  // ── Digital Twin (Rodada 7) ────────────────────────────────────────
  digitalTwinProfiles DigitalTwinProfile[]
  voiceProfiles       VoiceProfile[]
  identityConsents    IdentityConsent[]
  voiceConsents       VoiceConsent[]
  digitalTwinAssets   DigitalTwinAsset[]
  digitalTwinJobs     DigitalTwinJob[]
  workerTokens        WorkerToken[]

  // ── Machine Learning (Rodada 9, complemento) ────────────────────────
  mlTrainingRuns      MLTrainingRun[]
  mlModels            MLModel[]
  mlPredictions       MLPrediction[]
  mlFeatureSnapshots  MLFeatureSnapshot[]
  creativeExperiments CreativeExperiment[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("usuario")
  status    String   @default("pendente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Workspace em que esta usuária opera (hoje, sempre o próprio — ver nota
  // em Workspace.ownerId). Esta É a fronteira de isolamento de dados.
  workspaceId String
  workspace   Workspace @relation("WorkspaceMembers", fields: [workspaceId], references: [id])

  produtos       Produto[]
  conteudos      Conteudo[]
  integracoes    Integracao[]
  linksDinamicos LinkDinamico[]
  auditLogs      AuditLog[]
}

// Controle de quais módulos/telas ficam visíveis para cada papel (role).
// O admin sempre vê tudo (não gera linha aqui); só existe registro pra
// papéis restringíveis (hoje, só "usuario"). Ausência de linha = liberado
// por padrão, pra nada quebrar antes de qualquer configuração.
model ModuloPermissao {
  id        String   @id @default(cuid())
  role      String
  modulo    String
  liberado  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([role, modulo])
}

model LinkDinamico {
  id                String       @id @default(cuid())
  workspaceId       String
  workspace         Workspace    @relation(fields: [workspaceId], references: [id])
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  produtoId         String
  produto           Produto      @relation(fields: [produtoId], references: [id])
  slug              String       @unique
  plataforma        String
  urlDestino        String       @db.Text
  tipo              String       @default("afiliado")
  comissao          Float?
  precoAtual        Float?
  cliques           Int          @default(0)
  // DEPRECATED_LEGACY (Rodada 4): não é mais incrementado por nenhuma
  // operação nova nem lido por nenhum indicador novo. Sale/Commission são
  // a fonte única de vendas/comissões estruturadas — ver
  // DOCUMENTACAO-PATRONO-SELLER.md §10.1. Mantido só para não quebrar
  // registros antigos que dependiam dele antes desta rodada; não remover
  // sem migrar qualquer leitura remanescente primeiro.
  conversoes        Int          @default(0)
  // DEPRECATED_LEGACY (Rodada 4) — ver `conversoes` acima.
  receitaTotal      Float        @default(0)
  ativo             Boolean      @default(true)
  ultimaAtualizacao DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  eventos           EventoLink[]
  sales             Sale[]

  @@index([workspaceId])
}

model EventoLink {
  id String @id @default(cuid())

  // P0.2 Bloco 2: isolamento EXPLICITO. Antes o workspace do evento so
  // existia indiretamente, atraves de `link.workspaceId` — qualquer consulta
  // que esquecesse o join leria clique de outro negocio. Com a coluna
  // propria, a atribuicao filtra por workspace diretamente e o banco garante
  // a integridade pela FK.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  linkId     String
  link       LinkDinamico @relation(fields: [linkId], references: [id])
  tipo       String
  plataforma String?
  referer    String?
  createdAt  DateTime     @default(now())

  // Vendas atribuidas a ESTE clique. Um clique pode, em tese, preceder mais
  // de uma venda; a atribuicao nunca e criada por inferencia (ver
  // lib/atribuicao-clique.ts).
  sales Sale[]

  // Indice da consulta de atribuicao: workspace + link + ordem temporal.
  @@index([workspaceId, linkId, createdAt])
}

model Integracao {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  plataforma   String
  status       String    @default("desconectado")
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  tokenExpiry  DateTime?
  accountId    String?
  accountName  String?
  extraData    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([workspaceId, plataforma])
  @@index([userId])
}

model Produto {
  id              String         @id @default(cuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id])
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  nome            String
  categoria       String
  preco           Float?
  linkProduto     String?
  descricao       String?
  publicoAlvo     String[]
  origemConteudo  String
  tipoVenda       String
  observacoes     String?
  beneficios      String[]
  pontosNegativos String[]
  imagens         String[]
  videos          String[]
  status          String         @default("ativo")

  // ── Identidade externa e sincronização automática (Rodada 11) ──────────
  // AUTOMATION FIRST: a proprietária não deve cadastrar produto, preço,
  // imagem, comissão ou disponibilidade à mão quando a plataforma oferecer
  // isso por API oficial. Estes campos são o que torna essa importação
  // IDEMPOTENTE — sem eles, cada sincronização duplicaria a vitrine inteira.
  providerId  String? // 'tiktok-shop', 'amazon', 'mercado-livre'... (AFFILIATE_PROVIDER_REGISTRY)
  externalId  String? // id do produto NA PLATAFORMA de origem
  // MANUAL | TIKTOK_SHOWCASE | ... — alimenta o mapa de direitos de mídia
  // (lib/media-rights-produto.ts). Nunca é inferido do provider: mídia de
  // terceiro não pode entrar em vídeo como se fosse da proprietária.
  origemDados String  @default("MANUAL")
  sincronizadoEm DateTime?
  // Quando sumiu da origem. Inativamos preservando histórico — `status`
  // sozinho não distingue "a dona desativou" de "saiu da vitrine".
  removidoDaOrigemEm DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  conteudos       Conteudo[]
  linksDinamicos  LinkDinamico[]
  sales           Sale[]
  commissions     Commission[]

  // Garantia de idempotência no BANCO, não só na lógica — mesmo padrão de
  // `Sale.idempotencyKey`. Em Postgres NULL não colide com NULL, então
  // produto manual (providerId nulo) segue sem restrição.
  @@unique([workspaceId, providerId, externalId])
  @@index([workspaceId])
  @@index([workspaceId, origemDados])
}

model Conteudo {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id])
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  produtoId           String
  produto             Produto   @relation(fields: [produtoId], references: [id])
  roteiro             String?   @db.Text
  legendaTiktok       String?   @db.Text
  legendaInstagram    String?   @db.Text
  legendaYoutube      String?   @db.Text
  legendaWhatsapp     String?   @db.Text
  legendaFacebook     String?   @db.Text
  legendaMarketplace  String?   @db.Text
  hashtags            String[]
  textoTela           String?   @db.Text
  narracao            String?   @db.Text
  trilhaSugerida      String?
  promptVideoIA       String?   @db.Text
  promptCurto         String?   @db.Text
  promptNarracao      String?   @db.Text
  chamadaAcao         String?
  estilo              String?
  duracao             Int?
  redeSocial          String?
  objetivo            String?
  notaProduto         Float?
  pontosPositivos     String[]
  pontosNegativos     String[]
  veredito            String?
  status              String    @default("roteiro_gerado")
  dataPublicacao      DateTime?
  dataAgendamento     DateTime?
  visualizacoes       Int       @default(0)
  cliquesLink         Int       @default(0)
  comentarios         Int       @default(0)
  compartilhamentos   Int       @default(0)
  taxaConclusao       Float?
  alertasCompliance   Json[]
  videoUrl            String?   @db.Text
  videoRequestId      String?   @db.Text
  videoErro           String?   @db.Text
  publicacaoExternaId String?
  erroPublicacao      String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sales               Sale[]

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────
// Programa × Operação × Integração — distinção de negócio aprovada
// (design_handoff §6). As três coisas NÃO são sinônimos:
//
// - Programa    = a afiliada está cadastrada nesse programa? (status do
//                 relacionamento com a plataforma, ex.: Shopee)
// - Operação    = como o Patrono trabalha com esse programa hoje: manual
//                 ou integrado. Nesta fase, sempre MANUAL.
// - Integração  = existe conexão técnica real (token, API)? Nunca marcar
//                 CONNECTED sem uma integração de verdade — mostrar sempre
//                 "Manual" ou "Integração futura" enquanto não houver.
model AffiliateProgram {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Identificador técnico da plataforma (ex.: "shopee", "hotmart",
  // "mercadolivre", "amazon", "tiktokshop", "outro"). Não é uma integração
  // real — é só "de qual programa estamos falando".
  platform String

  // NOT_REGISTERED | REQUESTED | WAITING_APPROVAL | ACTIVE | NEEDS_CONFIGURATION
  status String @default("NOT_REGISTERED")

  // MANUAL | INTEGRATED — nesta fase do produto, sempre MANUAL.
  operationMode String @default("MANUAL")

  // NOT_AVAILABLE | FUTURE | CONFIGURED | CONNECTED | ERROR
  // Nunca setar CONNECTED sem uma Integracao real por trás.
  integrationStatus String @default("NOT_AVAILABLE")

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales       Sale[]
  commissions Commission[]

  @@unique([workspaceId, platform])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────
// Sale × Commission — venda e comissão são entidades separadas.
// Regra de negócio: venda ≠ comissão. Uma venda registrada não vira
// comissão recebida automaticamente; comissão prevista não é confirmada;
// confirmada não é recebida; venda cancelada nunca aparece como confirmada.
model Sale {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  productId String?
  product   Produto? @relation(fields: [productId], references: [id])

  affiliateProgramId String?
  affiliateProgram   AffiliateProgram? @relation(fields: [affiliateProgramId], references: [id])

  linkId String?
  link   LinkDinamico? @relation(fields: [linkId], references: [id])

  contentId String?
  content   Conteudo? @relation(fields: [contentId], references: [id])

  date   DateTime @default(now())
  amount Float?

  // PENDING | CONFIRMED | CANCELLED
  status String @default("PENDING")

  // manual | webhook (webhook não é usado ainda nesta fase)
  source String @default("manual")

  // ── P0.2 Bloco 1: PROVENIENCIA (nunca inferida) ─────────────────────
  // REAL_OPERATION | SEED | TEST_FIXTURE | DEMO | SYNTHETIC_TEST | UNVERIFIED
  // (lib/proveniencia.ts). `source` diz COMO a venda entrou; `dataOrigin`
  // diz SE ela representa operacao comercial real. Sao perguntas diferentes:
  // uma venda de teste tambem entra como "manual".
  //
  // O default e UNVERIFIED de proposito. Toda linha que ja existe no banco
  // passa a valer como "origem nao demonstravel" — nunca como real. Promover
  // historico a REAL_OPERATION por conveniencia seria ensinar o ML com dado
  // de origem duvidosa, que e exatamente o que a regra permanente proibe.
  // Fail-closed: perder dado de treino e melhor que contaminar o modelo.
  dataOrigin String @default("UNVERIFIED")

  // ── P0.2 Bloco 2: ATRIBUICAO (deterministica, nunca inventada) ───────
  // Clique que originou esta venda. `null` quando nao houve atribuicao
  // confiavel — e `attributionMethod` diz POR QUE. Nunca preenchido por
  // palpite, correlacao estatistica ou inferencia de ML.
  clickEventId String?
  clickEvent   EventoLink? @relation(fields: [clickEventId], references: [id])

  // Regra que produziu (ou recusou) a atribuicao acima — ver
  // lib/atribuicao-clique.ts. Gravado SEMPRE, inclusive quando nao houve
  // atribuicao: "nao atribuido" tambem e um resultado auditavel.
  attributionMethod String?

  notes String? @db.Text

  // Idempotência persistente (Rodada 4): a mesma operação lógica de
  // "registrar resultado" reenviada — duplo clique, retry de rede, timeout,
  // refresh — nunca cria uma segunda Sale/Commission. A tela gera esta
  // chave uma vez por tentativa de envio (ex.: crypto.randomUUID()) e a
  // reenvia em cada retry até ter sucesso; o servidor localiza a Sale já
  // criada com a mesma chave em vez de criar outra. Única por workspace;
  // opcional porque nem toda chamada (ex.: um script interno) precisa
  // gerar uma.
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions Commission[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, dataOrigin])
}

model Commission {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  productId String?
  product   Produto? @relation(fields: [productId], references: [id])

  affiliateProgramId String?
  affiliateProgram   AffiliateProgram? @relation(fields: [affiliateProgramId], references: [id])

  expectedAmount  Float?
  confirmedAmount Float?
  receivedAmount  Float?

  // EXPECTED | CONFIRMED | RECEIVED
  status String @default("EXPECTED")

  expectedAt  DateTime?
  confirmedAt DateTime?
  receivedAt  DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Auditoria — registro simples de operações de escrita importantes.
// Sem serviço externo, sem custo: só uma tabela no mesmo Postgres.
// NUNCA gravar senha, token ou segredo em `metadata`.
model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // ex.: "produto.criado", "programa.alterado", "venda.registrada"
  action String

  // ex.: "Produto", "AffiliateProgram", "LinkDinamico", "Conteudo",
  // "Sale", "Commission"
  entityType String
  entityId   String

  // Dados não sensíveis relevantes ao evento (ex.: campos alterados).
  // Nunca senha/token/segredo.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

// ── Digital Twin (Rodada 7) ─────────────────────────────────────────────
// Persistência real das fundações conceituais da Rodada 6. `workspaceId`
// SEMPRE resolvido no servidor (session.user.workspaceId) — nunca aceito
// do corpo/query da requisição. `ownerUserId`/`subjectUserId` são gravados
// como texto simples (mesmo padrão de `Workspace.ownerId`), sem chave
// estrangeira — não são o limite de isolamento; `workspaceId` é.

model IdentityConsent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  subjectUserId String // sempre a própria titular do workspace
  purpose       String
  version       String @default("v1")

  // NOT_REQUESTED | GRANTED | REVOKED | EXPIRED (lib/digital-twin.ts)
  status String @default("NOT_REQUESTED")

  grantedAt DateTime?
  revokedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([workspaceId])
}

model VoiceConsent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  subjectUserId String
  purpose       String
  version       String @default("v1")
  status        String @default("NOT_REQUESTED")

  grantedAt DateTime?
  revokedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([workspaceId])
}

model VoiceProfile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  ownerUserId String
  consentId   String? // aponta para VoiceConsent.id — sem FK Prisma (checagem feita em código)

  provider     String? // preenchido só quando um provider real for usado (ex.: "chatterbox-tts")
  modelVersion String?
  language     String  @default("pt-BR")

  // Kill switch — "DESATIVAR MEU AVATAR" também desativa a voz.
  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model DigitalTwinProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique // 1 perfil por workspace nesta fase (mesmo limite de "1 usuária = 1 workspace")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  ownerUserId String
  displayName String

  identityConsentId String?
  voiceProfileId    String?

  enabled    Boolean   @default(false) // kill switch — "DESATIVAR MEU AVATAR" (identidade/voz)
  approvedAt DateTime? // aprovação do PERFIL após a prévia (regra 42/43) — não é aprovação por vídeo

  // Kill switch nº 3 (Rodada 9, regra 34) — independente de `enabled`
  // (identidade/voz) e de `Workspace.automationPaused` (publicação). Pausa
  // só o WORKER local: nenhum job novo é reivindicado enquanto true.
  workerPaused Boolean @default(false)

  // Aprovação única da VOZ (Rodada 9, regra 11) — separada da aprovação do
  // perfil completo (approvedAt), porque a voz pode ser aprovada antes do
  // avatar estar pronto.
  voiceApprovedAt DateTime?

  // ── Preferências globais (Rodada 8, regra 50) ──────────────────────
  // Nunca perguntadas a cada postagem — o Autopilot só consulta isso uma
  // vez por ciclo.
  autoUseDigitalTwin Boolean @default(false)
  autoUseVoice       Boolean @default(false)
  allowFallback      Boolean @default(true)
  priorityChannel    String  @default("tiktok")
  defaultStyle       String  @default("presenter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets DigitalTwinAsset[]
  jobs   DigitalTwinJob[]
}

model DigitalTwinAsset {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  profileId String
  profile   DigitalTwinProfile @relation(fields: [profileId], references: [id])

  // FACE_IMAGE | REFERENCE_VIDEO | VOICE_REFERENCE | CONSENT_EVIDENCE | GENERATED_PREVIEW
  type String

  // Caminho no bucket PRIVADO do Supabase Storage — nunca uma URL pública
  // permanente. Acesso só via signed URL temporária (lib/supabase.ts).
  storagePath String
  mimeType    String
  purpose     String?
  active      Boolean @default(true)

  // Retenção de prévias (Rodada 8, regra 42) — GENERATED_PREVIEW rejeitada/
  // não usada expira e é limpa; referências permanentes (FACE_IMAGE,
  // REFERENCE_VIDEO, VOICE_REFERENCE, CONSENT_EVIDENCE) ficam com null.
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([workspaceId, profileId])
  @@index([expiresAt])
}

model DigitalTwinJob {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  profileId String
  profile   DigitalTwinProfile @relation(fields: [profileId], references: [id])

  // QUEUED | PREPARING_AUDIO | GENERATING_VOICE | GENERATING_AVATAR | LIP_SYNC
  // | RENDERING | VALIDATING | READY | FAILED | CANCELLED
  status String @default("QUEUED")

  // VOICE_PREVIEW | AVATAR_PREVIEW | PRODUCT_PREVIEW | PUBLISH (Rodada 9) —
  // distingue a FINALIDADE do job (ex.: prévia de voz sozinha nunca é
  // rotulada como lip-sync/avatar).
  jobType String @default("AVATAR_PREVIEW")

  contentId     String? // ligação futura com Conteudo, quando existir
  resultAssetId String?
  error         String?
  attempts      Int     @default(0)

  // ── Job Queue real (Rodada 8) ──────────────────────────────────────
  // Claim atômico: um worker só processa o job se conseguir gravar seu
  // workerId (via UPDATE condicional — ver lib/digital-twin-job-queue.ts).
  // heartbeatAt é renovado periodicamente enquanto processa; se parar de
  // renovar por mais que lockTimeoutMs, o job é considerado travado e
  // pode ser reclamado por outro worker (nunca fica preso para sempre).
  workerId       String?
  claimedAt      DateTime?
  heartbeatAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([status, workerId])
}

// Saúde do(s) worker(s) locais de geração — só para a tela de Configurações
// → Digital Twin, nunca para a Home (regra 37).
model GenerationWorkerHealth {
  id         String   @id @default(cuid())
  workerId   String   @unique
  online     Boolean  @default(true)
  gpuDetected Boolean @default(false)
  gpuName    String?
  vramGB     Float?
  version    String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

// Worker Pairing (Rodada 9, regras 21-22): credencial própria do worker,
// escopada a UM workspace — nunca a senha da usuária. Só o hash é
// persistido; o token bruto é devolvido uma única vez na criação e nunca
// mais recuperável (nem por quem tem acesso ao banco).
model WorkerToken {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  tokenHash String @unique
  label     String?

  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([workspaceId])
}

// ═══════════════════════════════════════════════════════════════════
// Machine Learning (Rodada 9, complemento — ML Real)
//
// Todo modelo/previsão é escopado por workspace (regra 39): dados de um
// workspace nunca treinam/alimentam o modelo de outro. Um modelo global
// agregando vários workspaces exigiria política de anonimização própria
// — não implementado nesta rodada.
// ═══════════════════════════════════════════════════════════════════

// Uma execução de treinamento (pode ou não resultar num MLModel novo —
// falha por dados insuficientes/erro também é registrada aqui).
model MLTrainingRun {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  modelFamily    String // ex.: "conversion_probability"
  datasetVersion String // versão/hash do snapshot de dados usado
  status         String @default("RUNNING") // RUNNING | COMPLETED | FAILED (ver lib/ml-types.ts)

  // Proveniência dos dados usados neste treinamento (correção pós-aprovação
  // do complemento ML — nunca REQUIRED-inferida, sempre declarada por quem
  // chama). Só REAL_OPERATION treina um modelo elegível para produção —
  // ver lib/ml-types.ts (MLDataOrigin) e MACHINE-LEARNING.md.
  dataOrigin String

  sampleCount   Int
  featureNames  String[]
  metrics       Json? // {rocAuc, precision, recall, mae, rmse, ...}
  baselineMetrics Json? // métricas do baseline determinístico, para o Promotion Gate comparar
  notes         String? @db.Text

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  models MLModel[]

  @@index([workspaceId, modelFamily])
}

// Um modelo treinado e versionado. Nunca vira ACTIVE sem passar pelo
// ModelPromotionGate (lib/ml-model-registry.ts) — precisa superar o
// baseline determinístico.
model MLModel {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  family   String // ex.: "conversion_probability"
  modelType String // ex.: "LOGISTIC_REGRESSION"
  version  Int

  trainingRunId          String?
  trainingRun            MLTrainingRun? @relation(fields: [trainingRunId], references: [id])
  trainingDate           DateTime
  trainingDatasetVersion String

  // Proveniência dos dados de treinamento — só um modelo treinado com
  // dataOrigin = REAL_OPERATION pode ser promovido a ACTIVE
  // (lib/ml-model-registry.ts, promoverModelo()). Um modelo TEST_FIXTURE/
  // DEMO/SEED/SYNTHETIC_TEST existe só para validar o motor de ML
  // (o "TEST_MODEL"), nunca para operar no workspace real.
  dataOrigin String

  features        String[]
  metrics         Json
  baselineMetrics Json?
  status          String @default("CANDIDATE") // CANDIDATE | VALIDATED | ACTIVE | DEPRECATED | ROLLED_BACK

  // Modelos desta rodada são pequenos o suficiente (poucos coeficientes)
  // para ficar inline no próprio banco — `artifactPath` fica reservado
  // para quando um modelo maior precisar de armazenamento externo.
  artifactPath String?
  artifact     Json?

  promotedAt   DateTime?
  deprecatedAt DateTime?
  rolledBackAt DateTime?
  createdAt    DateTime  @default(now())

  predictions MLPrediction[]

  @@unique([workspaceId, family, version])
  @@index([workspaceId, family, status])
}

// Toda previsão feita pelo PatronoMLEngine (ou pelo fallback
// determinístico) é registrada aqui — nunca "silenciosa" (regra 29, 37).
model MLPrediction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  modelRowId   String?
  model        MLModel? @relation(fields: [modelRowId], references: [id])
  modelFamily  String?
  modelVersion Int?
  decisionType String // RULE_BASED | STATISTICAL_LEARNING | MACHINE_LEARNING | MODEL_BASED

  entityType String // ex.: "AffiliateOpportunity" | "Conteudo"
  entityId   String?

  inputFeatures Json

  predictedConversionProbability Float?
  expectedCommissionValue        Float?

  createdAt DateTime @default(now())

  @@index([workspaceId, entityType])
  @@index([workspaceId, modelRowId])
}

// Snapshot de features versionado (regra 7). `label` só é preenchido
// DEPOIS que o resultado (venda/comissão) é conhecido — nunca no momento
// da extração das features, para nunca vazar informação futura (regra 31).
model MLFeatureSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  entityType     String // "Conteudo" | "Produto"
  entityId       String?
  featureVersion String

  // Proveniência real do dado (MLDataOrigin, lib/ml-types.ts):
  // REAL_OPERATION | TEST_FIXTURE | DEMO | SEED | SYNTHETIC_TEST. Nunca
  // opcional — o MLReadinessGate de produção só conta REAL_OPERATION
  // (regra pós-aprovação: dado de teste/fixture/demo/seed nunca conta
  // para decidir se o workspace real está pronto para treinar/ativar um
  // modelo).
  dataOrigin String

  features Json
  label    Json?

  capturedAt DateTime  @default(now())
  labeledAt  DateTime?

  @@index([workspaceId, entityType])
}

// Teste A/B de criativo (regra 24) — hook, CTA, duração, avatar/B-roll,
// etc. Estratégia de atribuição simples e auditável (epsilon-greedy).
model CreativeExperiment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name      String
  dimension String // "hook" | "cta" | "duration" | "avatar_vs_broll" | ...
  variantA  Json
  variantB  Json

  assignmentStrategy String  @default("EPSILON_GREEDY")
  epsilon            Float   @default(0.1)
  status             String  @default("RUNNING") // RUNNING | CONCLUDED | CANCELLED

  assignments Json[] @default([]) // [{ variant, entityId, assignedAt }]
  resultsA    Json?
  resultsB    Json?
  winner      String? // "A" | "B"

  startedAt   DateTime  @default(now())
  concludedAt DateTime?

  @@index([workspaceId, status])
}
